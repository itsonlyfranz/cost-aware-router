# Copy to .env (gitignored). Only needed for live runs; tests and the default demo are offline.
ANTHROPIC_API_KEY=

# Model tiers (defaults shown). CAR_DEFAULT_MODEL is the balanced tier.
CAR_DEFAULT_MODEL=claude-sonnet-5-5
CAR_MODEL_FAST=claude-haiku-5-5
CAR_MODEL_PREMIUM=claude-opus-5-5

# Optional price overrides in USD per million tokens: "input,output"
# CAR_PRICE_FAST=1.0,5.0
# CAR_PRICE_BALANCED=3.0,15.0
# CAR_PRICE_PREMIUM=5.0,25.0

# Routing knobs; CAR_BASELINE_TIER (fast|balanced|premium) is the tier savings are measured against
CAR_BASELINE_TIER=premium
CAR_CONFIDENCE_THRESHOLD=0.8
CAR_DATA_DIR=.car
